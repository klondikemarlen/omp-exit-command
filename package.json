{
  "name": "omp-exit-command",
  "version": "1.3.0",
  "description": "Exit Oh My Pi with explicit commands or conversational farewells.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "test": "node --test"
  },
  "devDependencies": {
    "oxlint": "1.95.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-exit-command.git"
  },
  "homepage": "https://github.com/klondikemarlen/omp-exit-command#readme",
  "bugs": {
    "url": "https://github.com/klondikemarlen/omp-exit-command/issues"
  },
  "qna": false,
  "keywords": [
    "omp",
    "oh-my-pi",
    "plugin",
    "extension"
  ],
  "files": [
    "index.js",
    "ai-exit.js",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./index.js"
    ],
    "features": {
      "ai-exit-detection": {
        "description": "Enable model-assisted exit detection and suggestion-only follow-ups.",
        "default": true,
        "extensions": [
          "./ai-exit.js"
        ]
      }
    }
  }
}
